#!/bin/sh
export GRADLE_HOME=/workspace/gradle-8.7
export JAVA_HOME=/root/.local/share/mise/installs/java/17.0.2
exec "$JAVA_HOME/bin/java" -Xmx2048m -Dfile.encoding=UTF-8 -Djava.net.preferIPv4Stack=true -Dhttp.proxyHost=127.0.0.1 -Dhttp.proxyPort=18080 -Dhttps.proxyHost=127.0.0.1 -Dhttps.proxyPort=18080 -cp "$GRADLE_HOME/lib/gradle-launcher-8.7.jar" org.gradle.launcher.GradleMain "$@"
